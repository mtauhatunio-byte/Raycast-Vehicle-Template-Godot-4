[sub_resource type="GDScript" id="GDScript_ap8cd"]
resource_name = "speed"
script/source = "extends Label

var root : CarCore = null

func _ready() -> void:
	root = get_owner()



func _process(delta: float) -> void:
	if root:
		text = \"Speed : \" + str(round(int(root.linear_velocity.length())))
"

