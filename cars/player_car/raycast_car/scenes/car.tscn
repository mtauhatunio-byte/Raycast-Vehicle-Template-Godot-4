[sub_resource type="LabelSettings" id="LabelSettings_j5jx5"]
font_size = 64
font_color = Color(0, 0, 0, 1)
outline_size = 29
shadow_size = 128
shadow_color = Color(0, 0, 0, 1)

[sub_resource type="GDScript" id="GDScript_00nse"]
resource_name = "speed"
script/source = "extends Label

var root : RayCastCar = null

func _ready() -> void:
	root = get_owner()



func _process(delta: float) -> void:
	if root:
		text = \"Speed : \" + str(round(int(root.linear_velocity.length())))
"

