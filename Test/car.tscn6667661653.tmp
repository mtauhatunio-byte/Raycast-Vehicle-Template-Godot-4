[sub_resource type="GDScript" id="GDScript_tsrje"]
resource_name = "Speed"
script/source = "extends Label

@export var car: RaycastCar

func _process(delta: float) -> void:
	text = \"Speed: \" + str(round(int(car.linear_velocity.length())))
"

